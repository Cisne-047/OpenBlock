{
  "name": "openblock",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenBlock — forja servidores de Minecraft según tu hardware. Detección + tuning automático en Windows y Linux.",
  "license": "MIT",
  "bin": {
    "openblock": "bin/openblock.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "openblock": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx src/index.ts self-test",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.9"
  }
}
